Package: rCoros
Title: Access COROS Training Hub Fitness Data
Version: 0.1.0
Date: 2026-06-07
Authors@R:
    person(
        given   = "Matt",
        family  = "O'Reilly",
        email   = "fermoymatt@gmail.com",
        role    = c("aut", "cre")
